{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "framework": null,
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron-subscription-renewal",
      "schedule": "0 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/googlec82c9dc9a541d03e.html",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/sitemaps/:path*",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/llms.txt",
      "destination": "/api"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  }
}
